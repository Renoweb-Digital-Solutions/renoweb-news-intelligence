# All values are server-only. Never rename them with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
AUTH_FRONTEND_ORIGIN=http://localhost:3000
# Must match the backend's private service key.
AUTH_INTERNAL_API_KEY=
# Set only when your ingress overwrites this header and direct access is blocked.
# Otherwise auth throttling deliberately uses a shared client bucket.
AUTH_TRUSTED_CLIENT_IP_HEADER=
# Optional isolated build output when .next is in use.
# SNOOPTEL_BUILD_DIR=.next-verification
